rules_version = '2';

// =============================================================================
// Gia Pha Viet Nam - Security Rules
//
// Cau hinh Firebase phia client la cong khai, nen TOAN BO bao mat nam o day.
// Nguyen tac: khong ai doc duoc gi neu chua la thanh vien cua dong ho do.
//
// Quy trinh tham gia: dang nhap Google -> tao yeu cau vao ho -> chu ho duyet
// -> chu ho tao ban ghi thanh vien. Nguoi chua duoc duyet khong doc duoc gi.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function membershipPath(clanId) {
      return /databases/$(database)/documents/clans/$(clanId)/memberships/$(request.auth.uid);
    }

    function isMember(clanId) {
      return signedIn() && exists(membershipPath(clanId));
    }

    function myRole(clanId) {
      return get(membershipPath(clanId)).data.role;
    }

    function canEdit(clanId) {
      return isMember(clanId) && myRole(clanId) in ['owner', 'editor'];
    }

    // Muc 'binh luan': ghi chu duoc nhung khong sua duoc thong tin nguoi.
    // Bang nay phai khop voi src/domain/perm.ts.
    function canComment(clanId) {
      return isMember(clanId) && myRole(clanId) in ['owner', 'editor', 'commenter'];
    }

    function isOwner(clanId) {
      return isMember(clanId) && myRole(clanId) == 'owner';
    }

    // -------------------------------------------------- tim cac cay cua minh
    //
    // Khong liet ke duoc tu phia /clans (allow list: if false, neu khong la lo
    // danh sach moi dong ho tren he thong). Nen hoi nguoc tu phia membership:
    // moi nguoi chi doc duoc chinh ban ghi mang uid cua minh, o bat ky cay nao.
    //
    // Truy van phia client BUOC phai kem where('uid','==',uid) thi luat nay moi
    // duyet duoc — do dung mau quyen so huu ma Firebase khuyen nghi cho
    // collection group. Ban ghi membership vi the phai co truong uid, va luat
    // ghi ben duoi ep truong do bang chinh id document.
    match /{path=**}/memberships/{mid} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // ---------------------------------------------------------------- dong ho

    match /clans/{clanId} {
      // Ai dang nhap cung doc duoc document nay, vi no chi chua ten dong ho va
      // uid cua chu ho - khong co du lieu gia pha. Can the de app phan biet
      // "dong ho chua ton tai" voi "ton tai nhung minh chua duoc duyet".
      // Du lieu that nam o cac collection con, van khoa chat theo membership.
      allow get: if signedIn();
      // Khong cho liet ke toan bo dong ho tren he thong.
      allow list: if false;

      // Ai dang nhap cung tao duoc dong ho cua minh, nhung phai tu nhan lam chu.
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isOwner(clanId) && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;

      // ------------------------------------------------------------ thanh vien

      match /memberships/{uid} {
        allow read: if isMember(clanId);

        // Nguoi vua tao dong ho tu ghi minh lam chu. Ngoai ra chi chu ho moi
        // them duoc nguoi khac - day la chot chan duy nhat de vao duoc du lieu.
        // Truong uid phai bang chinh id document, neu khong luat collection
        // group o tren se tin vao mot gia tri bia.
        allow create: if signedIn()
          && request.resource.data.uid == uid
          && (
            (request.auth.uid == uid
              && request.resource.data.role == 'owner'
              && get(/databases/$(database)/documents/clans/$(clanId)).data.ownerUid == request.auth.uid)
            || isOwner(clanId)
          );
        allow update: if isOwner(clanId)
          && request.resource.data.uid == uid
          // Chu ho khong tu ha quyen minh, tranh khoa chet dong ho.
          && !(uid == request.auth.uid && request.resource.data.role != 'owner');
        allow delete: if isOwner(clanId)
          && !(uid == request.auth.uid);
      }

      // --------------------------------------------------------- xin vao dong ho

      match /joinRequests/{uid} {
        // Nguoi xin chi thay yeu cau cua chinh minh; chu ho thay tat ca.
        allow read: if signedIn() && (request.auth.uid == uid || isOwner(clanId));
        allow create: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && (request.auth.uid == uid || isOwner(clanId));
        allow update: if false;
      }

      // ----------------------------------------------------------- nguoi trong ho

      match /members/{memberId} {
        allow read: if isMember(clanId);
        allow create, update, delete: if canEdit(clanId);
      }

      match /marriages/{marriageId} {
        allow read: if isMember(clanId);
        allow create, update, delete: if canEdit(clanId);
      }

      match /notes/{noteId} {
        allow read: if isMember(clanId);
        // Khong cho mao danh nguoi khac khi ghi chu.
        allow create: if canComment(clanId) && request.resource.data.authorUid == request.auth.uid;
        allow update: if false;
        allow delete: if isMember(clanId)
          && (resource.data.authorUid == request.auth.uid || isOwner(clanId));
      }
    }

    // ---------------------------------------------------------------- ho so rieng

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Moi thu khong khop luat nao o tren deu bi tu choi.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
