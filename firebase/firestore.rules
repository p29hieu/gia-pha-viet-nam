rules_version = '2';

// =============================================================================
// Gia Pha Viet Nam - Security Rules
//
// Cau hinh Firebase phia client la cong khai, nen TOAN BO bao mat nam o day.
// Nguyen tac: khong ai doc duoc gi neu chua la thanh vien cua dong ho do.
//
// Ba muc quyen cap duoc cho nguoi dong gop:
//   viewer    - xem va tim kiem
//   commenter - them ghi chu
//   admin     - toan quyen: sua nguoi, sua quan he, moi va duyet nguoi vao
//
// 'owner' la nguoi lap cay, khong phai muc cap duoc. Khac admin dung hai diem,
// ca hai deu de tranh khoa chet dong ho: khong ai ha duoc quyen chu, va khong
// ai dung duoc vao ban ghi thanh vien cua chinh chu.
//
// Bang nay phai khop tung dong voi src/domain/perm.ts.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function membershipPath(clanId) {
      return /databases/$(database)/documents/clans/$(clanId)/memberships/$(request.auth.uid);
    }

    function isMember(clanId) {
      return signedIn() && exists(membershipPath(clanId));
    }

    function myRole(clanId) {
      return get(membershipPath(clanId)).data.role;
    }

    function ownerUid(clanId) {
      return get(/databases/$(database)/documents/clans/$(clanId)).data.ownerUid;
    }

    // 'editor' la ten cu cua 'admin', con sot lai trong du lieu tu truoc khi
    // doi ten muc. Van chap nhan de khong phai sua du lieu; phia client
    // normaliseRole() quy no ve 'admin' khi doc.
    function canEdit(clanId) {
      return isMember(clanId) && myRole(clanId) in ['owner', 'admin', 'editor'];
    }

    function canComment(clanId) {
      return isMember(clanId) && myRole(clanId) in ['owner', 'admin', 'editor', 'commenter'];
    }

    // Moi nguoi, duyet nguoi xin vao, doi muc quyen cua nguoi khac.
    function canManage(clanId) {
      return isMember(clanId) && myRole(clanId) in ['owner', 'admin', 'editor'];
    }

    function isOwner(clanId) {
      return isMember(clanId) && myRole(clanId) == 'owner';
    }

    // -------------------------------------------------- tim cac cay cua minh
    //
    // Khong liet ke duoc tu phia /clans (allow list: if false, neu khong la lo
    // danh sach moi dong ho tren he thong). Nen hoi nguoc tu phia membership:
    // moi nguoi chi doc duoc chinh ban ghi mang uid cua minh, o bat ky cay nao.
    //
    // Truy van phia client BUOC phai kem where('uid','==',uid) thi luat nay moi
    // duyet duoc — do dung mau quyen so huu ma Firebase khuyen nghi cho
    // collection group. Ban ghi membership vi the phai co truong uid, va luat
    // ghi ben duoi ep truong do bang chinh id document.
    match /{path=**}/memberships/{mid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------------------------------------------------------------- dong ho

    match /clans/{clanId} {
      // Ai dang nhap cung doc duoc document nay, vi no chi chua ten dong ho va
      // uid cua chu ho - khong co du lieu gia pha. Can the de app phan biet
      // "dong ho chua ton tai" voi "ton tai nhung minh chua duoc duyet".
      // Du lieu that nam o cac collection con, van khoa chat theo membership.
      allow get: if signedIn();
      // Khong cho liet ke toan bo dong ho tren he thong.
      allow list: if false;

      // Ai dang nhap cung lap duoc cay gia pha rieng, nhung phai tu nhan lam chu.
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      // Doi ten cay thi admin lam duoc; sang tay quyen chu thi khong.
      allow update: if canManage(clanId)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;

      // ------------------------------------------------------------ thanh vien

      match /memberships/{uid} {
        allow read: if isMember(clanId);

        // Hai duong vao: nguoi vua lap cay tu ghi minh lam chu, hoac admin them
        // nguoi khac. Day la chot chan duy nhat de vao duoc du lieu gia pha.
        //
        // Truong uid phai bang chinh id document, neu khong luat collection
        // group o tren se tin vao mot gia tri bia.
        allow create: if signedIn()
          && request.resource.data.uid == uid
          && (
            (request.auth.uid == uid
              && request.resource.data.role == 'owner'
              && ownerUid(clanId) == request.auth.uid)
            ||
            // Admin them nguoi, nhung khong phong duoc ai lam chu ho.
            (canManage(clanId) && request.resource.data.role != 'owner')
          );

        // Ban ghi cua chu ho bat kha xam pham — ke ca chinh chu cung khong tu
        // ha quyen minh, vi ha xong la dong ho khong con ai mo khoa duoc.
        allow update: if canManage(clanId)
          && request.resource.data.uid == uid
          && uid != ownerUid(clanId)
          && request.resource.data.role != 'owner';

        allow delete: if canManage(clanId) && uid != ownerUid(clanId);
      }

      // --------------------------------------------------------- xin vao dong ho

      match /joinRequests/{uid} {
        // Nguoi xin chi thay yeu cau cua chinh minh; admin thay tat ca.
        allow read: if signedIn() && (request.auth.uid == uid || canManage(clanId));
        allow create: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && (request.auth.uid == uid || canManage(clanId));
        allow update: if false;
      }

      // ----------------------------------------------------------- nguoi trong ho

      match /members/{memberId} {
        allow read: if isMember(clanId);
        allow create, update, delete: if canEdit(clanId);
      }

      match /marriages/{marriageId} {
        allow read: if isMember(clanId);
        allow create, update, delete: if canEdit(clanId);
      }

      match /notes/{noteId} {
        allow read: if isMember(clanId);
        // Khong cho mao danh nguoi khac khi ghi chu.
        allow create: if canComment(clanId) && request.resource.data.authorUid == request.auth.uid;
        allow update: if false;
        allow delete: if isMember(clanId)
          && (resource.data.authorUid == request.auth.uid || canManage(clanId));
      }
    }

    // ---------------------------------------------------------------- ho so rieng

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Moi thu khong khop luat nao o tren deu bi tu choi.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
