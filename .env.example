# Google Apps Script — ban cu, se go sau khi Firebase chay on dinh
VITE_API_URL=

# Firebase. Day la dinh danh CONG KHAI, khong phai bi mat: chung nam san trong
# goi JS ma ai mo trang cung doc duoc. Bao mat cua Firebase den tu Authentication
# va Security Rules, khong den tu viec giau nhung gia tri nay.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
